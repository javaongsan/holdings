<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.audit.tvcatch">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <application android:label="TV Catch (audit)">
    <activity android:name=".Catch" android:exported="true" android:theme="@android:style/Theme.DeviceDefault.Dialog">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="tvoneweblogin" android:host="centralizedclientlogin"/>
        <data android:scheme="tvoneweblogin" android:host="sociallogin"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
